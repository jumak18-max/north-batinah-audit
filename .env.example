VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: if you want service_role for server-side scripts (never expose in client)
# VITE_SUPABASE_SERVICE_ROLE_KEY=

# How to fill:
# 1. Create Supabase project at https://supabase.com
# 2. Go to Project Settings > API > Project URL and anon public key
# 3. Copy them here for local dev, and add same vars in Vercel Dashboard > Settings > Environment Variables
